# Cada ruta tiene su index.html prerenderizado (dist/<ruta>/index.html).
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Un solo dominio canónico: https sin www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://mttransfers.com%{REQUEST_URI} [L,R=301]

  # Markdown para agentes: solo si la petición lo pide (Accept: text/markdown) y existe el .md
  # de esa página (scripts/markdown.mjs). Los navegadores nunca envían ese Accept: siguen con HTML.
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{DOCUMENT_ROOT}/index.md -f
  RewriteRule ^$ index.md [L]

  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.md -f
  RewriteRule ^(.+?)/?$ $1/index.md [L]
</IfModule>

# El mismo URL devuelve HTML o Markdown según el Accept: las cachés deben distinguirlo.
AddType text/markdown .md
AddCharset UTF-8 .md

# Descubrimiento para agentes (RFC 8288): cada página HTML anuncia solo recursos que existen.
# No se anuncia api-catalog ni service-doc porque el sitio no tiene API.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    # Comillas simples por fuera: LiteSpeed (Hostinger) no interpreta \" como Apache y dejaba las barras en el valor.
    Header always set Link '<https://mttransfers.com/sitemap.xml>; rel="sitemap"; type="application/xml"'
    Header always append Link '<https://mttransfers.com/llms.txt>; rel="describedby"; type="text/plain"'
    Header always append Vary Accept
  </FilesMatch>
  <FilesMatch "\.md$">
    Header always append Vary Accept
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
